    >

    <div class="hero-copy">
      <h1>Hello, I'm Mifta Hatul Jannat</h1>

      <p>
        Second-year Bachelor of Pharmacy (B.Pharm) student<br>
        Manarat International University
      </p>

      <a class="button" href="#about">
        Explore My Portfolio
      </a>
    </div>

  </div>

  <main>

    <section id="about">
      <h2>About Me</h2>

