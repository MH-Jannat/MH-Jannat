        </div>
      </div>
    </section>

    <section id="interests">
      <h2>Hobbies &amp; Interests</h2>

      <div class="card">
        <div class="tags">
          <span class="tag">Reading</span>
          <span class="tag">Case-file documentaries</span>
          <span class="tag">Nature documentaries</span>
          <span class="tag">Wildlife documentaries</span>
          <span class="tag">Podcasts</span>
        </div>
      </div>
    </section>

    <section id="workshops">
      <h2>Academic Achievements &amp; Workshops</h2>

      <div class="card">
        <h3>Secondary School Certificate (SSC)</h3>
        <p>GPA: 5.00</p>
      </div>

      <div class="card">
        <h3>Higher Secondary Certificate (HSC)</h3>
        <p>GPA: 4.80</p>
      </div>

      <div class="card">
        <h3>Career Guidance Workshop</h3>
        <p>Workshop attended</p>
      </div>

      <div class="card">
        <h3>Artificial Intelligence (AI) Workshop</h3>
        <p>Workshop attended</p>
      </div>
    </section>

    <section id="contact" class="contact">
      <h2>Contact</h2>

      <div class="card">
        <p>
          Email:
          <a href="mailto:callmiftah@gmail.com">
            callmiftah@gmail.com
          </a>
        </p>
      </div>
    </section>

  </main>

  <footer>
    <p>
      &copy; 2026 Mifta Hatul Jannat | Pharmacy Student Portfolio
    </p>
  </footer>

</body>
</html>
